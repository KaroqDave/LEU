{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "id", "ok", "result"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "ok": { "const": true },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engineVersion", "platform", "arch"],
          "properties": {
            "engineVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
            "arch": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "id", "ok", "error"],
      "properties": {
        "protocolVersion": { "type": "integer", "minimum": 1 },
        "id": { "type": ["string", "null"], "maxLength": 64 },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": ["INVALID_REQUEST", "PROTOCOL_MISMATCH", "UNKNOWN_METHOD", "FRAME_TOO_LARGE"]
            },
            "message": { "type": "string", "maxLength": 256 }
          }
        }
      }
    }
  ]
}
