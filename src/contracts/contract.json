{
  "errorCode": {
    "enum": [
      "INVALID_REQUEST",
      "PROTOCOL_MISMATCH",
      "UNKNOWN_METHOD",
      "FRAME_TOO_LARGE",
      "RESPONSE_TOO_LARGE"
    ],
    "title": "EngineRemoteErrorCode",
    "type": "string"
  },
  "limits": { "requestBytes": 16384, "responseBytes": 8388608 },
  "methods": {
    "engine.version": {
      "params": { "additionalProperties": false, "type": "object" },
      "result": {
        "additionalProperties": false,
        "properties": {
          "arch": { "maxLength": 32, "minLength": 1, "type": "string" },
          "engineVersion": { "maxLength": 64, "minLength": 1, "type": "string" },
          "platform": { "maxLength": 32, "minLength": 1, "type": "string" }
        },
        "required": ["engineVersion", "platform", "arch"],
        "type": "object"
      },
      "typeName": "EngineVersion"
    },
    "inventory.list": {
      "params": { "additionalProperties": false, "type": "object" },
      "result": {
        "additionalProperties": false,
        "properties": {
          "issues": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "code": {
                  "enum": ["ACCESS_DENIED", "READ_FAILED", "INVALID_VALUE", "LIMIT_REACHED"],
                  "type": "string"
                },
                "message": { "type": "string" },
                "source": {
                  "additionalProperties": false,
                  "properties": {
                    "hive": { "enum": ["HKCU", "HKLM"], "type": "string" },
                    "key": { "maxLength": 1024, "type": "string" },
                    "view": { "enum": ["shared", "x86", "x64"], "type": "string" }
                  },
                  "required": ["hive", "view", "key"],
                  "type": "object"
                }
              },
              "required": ["source", "code", "message"],
              "type": "object"
            },
            "maxItems": 64,
            "type": "array"
          },
          "issuesOmitted": { "minimum": 0, "type": "integer" },
          "programs": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": { "maxLength": 2048, "minLength": 1, "type": "string" },
                "installLocation": { "type": ["string", "null"] },
                "name": { "maxLength": 4096, "minLength": 1, "type": "string" },
                "publisher": { "type": ["string", "null"] },
                "reportedInstallDate": { "type": ["string", "null"] },
                "reportedSizeBytes": {
                  "maximum": 4398046510080,
                  "minimum": 0,
                  "type": ["integer", "null"]
                },
                "scope": { "enum": ["user", "machine"], "type": "string" },
                "source": {
                  "additionalProperties": false,
                  "properties": {
                    "hive": { "enum": ["HKCU", "HKLM"], "type": "string" },
                    "key": { "maxLength": 1024, "type": "string" },
                    "view": { "enum": ["shared", "x86", "x64"], "type": "string" }
                  },
                  "required": ["hive", "view", "key"],
                  "type": "object"
                },
                "systemComponent": { "type": "boolean" },
                "updateRegistration": {
                  "description": "A child update, hotfix, or service pack registration (ParentKeyName or ReleaseType).",
                  "type": "boolean"
                },
                "version": { "type": ["string", "null"] }
              },
              "required": [
                "id",
                "name",
                "publisher",
                "version",
                "scope",
                "reportedSizeBytes",
                "reportedInstallDate",
                "installLocation",
                "source",
                "systemComponent",
                "updateRegistration"
              ],
              "type": "object"
            },
            "maxItems": 4096,
            "type": "array"
          },
          "status": { "enum": ["complete", "partial", "unavailable"], "type": "string" }
        },
        "required": ["status", "programs", "issues", "issuesOmitted"],
        "type": "object"
      },
      "typeName": "InventoryList"
    }
  },
  "protocolVersion": 1,
  "request": {
    "additionalProperties": false,
    "properties": {
      "id": { "maxLength": 64, "minLength": 1, "type": "string" },
      "method": { "maxLength": 64, "minLength": 1, "type": "string" },
      "params": { "additionalProperties": true, "type": "object" },
      "protocolVersion": { "minimum": 1, "type": "integer" }
    },
    "required": ["protocolVersion", "id", "method", "params"],
    "title": "EngineRequest",
    "type": "object"
  },
  "response": {
    "anyOf": [
      {
        "additionalProperties": false,
        "properties": {
          "id": { "maxLength": 64, "minLength": 1, "type": "string" },
          "ok": { "const": true, "type": "boolean" },
          "protocolVersion": { "minimum": 1, "type": "integer" },
          "result": { "additionalProperties": true, "type": "object" }
        },
        "required": ["protocolVersion", "id", "ok", "result"],
        "title": "EngineSuccessResponse",
        "type": "object"
      },
      {
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "INVALID_REQUEST",
                  "PROTOCOL_MISMATCH",
                  "UNKNOWN_METHOD",
                  "FRAME_TOO_LARGE",
                  "RESPONSE_TOO_LARGE"
                ],
                "title": "EngineRemoteErrorCode",
                "type": "string"
              },
              "message": { "maxLength": 256, "type": "string" }
            },
            "required": ["code", "message"],
            "type": "object"
          },
          "id": { "maxLength": 64, "type": ["string", "null"] },
          "ok": { "const": false, "type": "boolean" },
          "protocolVersion": { "minimum": 1, "type": "integer" }
        },
        "required": ["protocolVersion", "id", "ok", "error"],
        "title": "EngineFailureResponse",
        "type": "object"
      }
    ],
    "title": "EngineResponse"
  }
}
